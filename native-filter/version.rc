#include <windows.h>
#include "../config/app_version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MMDIRECT_VERSION_MAJOR,MMDIRECT_VERSION_MINOR,MMDIRECT_VERSION_PATCH,0
 PRODUCTVERSION MMDIRECT_VERSION_MAJOR,MMDIRECT_VERSION_MINOR,MMDIRECT_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "hato\0"
            VALUE "FileDescription", "MMDirectEncoder DirectShow Filter\0"
            VALUE "FileVersion", MMDIRECT_VERSION_STRING
            VALUE "InternalName", "MMDirectEncoder.dll\0"
            VALUE "OriginalFilename", "MMDirectEncoder.dll\0"
            VALUE "ProductName", "MMDirectEncoder\0"
            VALUE "ProductVersion", MMDIRECT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
